{
  "name": "@striderlabs/mcp-marriott",
  "version": "0.1.0",
  "description": "MCP server for Marriott Hotels — let AI agents search hotels, manage reservations, check in, and redeem Bonvoy points via browser automation",
  "main": "dist/index.js",
  "bin": {
    "striderlabs-mcp-marriott": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.api.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "marriott",
    "hotel",
    "booking",
    "bonvoy",
    "travel",
    "reservation",
    "ai-agent",
    "strider",
    "model-context-protocol",
    "browser-automation",
    "playwright"
  ],
  "author": "Strider Labs <hello@striderlabs.ai>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.8.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vercel/node": "^13.0.1",
    "typescript": "^5.3.3"
  }
}
