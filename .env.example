# Marriott credentials. Keep these only in Vercel/local env files.
MARRIOTT_EMAIL=
MARRIOTT_PASSWORD=

# Required bearer token for POST/GET/DELETE /api/mcp.
MCP_AUTH_TOKEN=

# Automatically provided by the private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional stable private Blob path overrides.
MARRIOTT_SESSION_STATE_PATH=marriott/storage-state.json
MARRIOTT_SESSION_INFO_PATH=marriott/session.json

# Optional local override. Vercel uses @sparticuz/chromium automatically.
PLAYWRIGHT_EXECUTABLE_PATH=
